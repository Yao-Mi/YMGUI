/* 复制为 apps/example.c，在 phone_app_catalog.def 添加 PHONE_APP(EXAMPLE, example)。 */
#include "phone_ui.h"
#include "phone_host.h"

static struct
{
	GYOBJ label;
	int count;
} state;

static void clicked(GYOBJ button)
{
	(void)button;
	char text[40];
	snprintf(text, sizeof(text), "点击了 %d 次", ++state.count);
	PhoneUI_text_set(state.label, text);
}

static void create(GYOBJ view)
{
	state.count = 0;
	PhoneUI_app_header(view, "示例应用", "独立模块 · 自动接入桌面");
	state.label = PhoneUI_label(view, 20, 100, 280, "点击了 0 次", INK);
	PhoneUI_button(view, 20, 150, 280, 44, "点击", clicked, ACCENT);
}

static void destroy(void)
{
	state.label = NULL; /* 控件由宿主递归释放，不重复 Free。 */
	state.count = 0;
}

const PhoneApp PhoneApp_example = {
	.key = "example", .title = "示例", .color = ACCENT, .icon = ICON_TASK, .create = create, .destroy = destroy};
